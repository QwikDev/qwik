import { useSignal, createSsrNodeId, renderSsrAttr, escapeHTML, maybeThen } from '@qwik.dev/core';
export default (props, ctx) => {
  const on = useSignal(false);
  const id0 = ctx.nextId();
  ctx.addRoot(on);
  const attr0 = renderSsrAttr(id0, 'required', on);
  const attr1 = renderSsrAttr(id0, 'aria-hidden', on);
  const attr2 = renderSsrAttr(id0, 'draggable', on);
  const attr3 = renderSsrAttr(id0, 'spellcheck', on);
  return maybeThen(attr0, (attr0) =>
    maybeThen(attr1, (attr1) =>
      maybeThen(attr2, (attr2) =>
        maybeThen(attr3, (attr3) => [
          '<section><input aria-hidden="false" draggable="false" spellcheck="false" tabIndex="-1" data-n="2" hidden><input q:id="',
          createSsrNodeId(id0),
          '"',
          attr0 === null ? '' : ' required' + (attr0 === '' ? '' : '="' + escapeHTML(attr0) + '"'),
          attr1 === null
            ? ''
            : ' aria-hidden' + (attr1 === '' ? '' : '="' + escapeHTML(attr1) + '"'),
          attr2 === null ? '' : ' draggable' + (attr2 === '' ? '' : '="' + escapeHTML(attr2) + '"'),
          attr3 === null
            ? ''
            : ' spellcheck' + (attr3 === '' ? '' : '="' + escapeHTML(attr3) + '"'),
          ' tabIndex="-1" data-n="2"></section>',
        ])
      )
    )
  );
};
