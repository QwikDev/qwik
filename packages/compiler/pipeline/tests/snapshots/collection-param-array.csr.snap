import { useSignal } from '@qwik.dev/core';
export default () => {
  const items = useSignal([]);
  const fallback = useSignal('Untitled');
  return <ul>{items.value.map(([id, , title = fallback.value, ...rest]) => <li key={id} onClick$={() => console.log(title)}>{title + rest.length}</li>)}</ul>;
};
