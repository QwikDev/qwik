import { useSignal } from '@qwik.dev/core';
export default () => {
  const items = useSignal([]);
  const fallback = useSignal(null);
  return <ul>{items.value.map((item = fallback.value) => <li key={item.id} onClick$={() => console.log(item.title)}>{item.title}</li>)}</ul>;
};
