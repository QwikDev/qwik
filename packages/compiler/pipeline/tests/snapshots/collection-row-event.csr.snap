import { useSignal } from '@qwik.dev/core';
export default () => {
  const items = useSignal([{ id: 'a' }]);
  return (
    <ul>
      {items.value.map((item) => (
        <li key={item.id}>
          <button onClick$={() => console.log(item.id)}>x</button>
        </li>
      ))}
    </ul>
  );
};

