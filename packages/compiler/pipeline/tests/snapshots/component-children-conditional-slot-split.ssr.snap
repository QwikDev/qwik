import { Slot, useSignal } from '@qwik.dev/core';
export const Panel = () => <main><Slot name="x" /><Slot name="y" /></main>;
export default () => {
  const flip = useSignal(false);
  return <Panel>{flip.value ? <a q:slot="x">alpha</a> : <b q:slot="y">bravo</b>}</Panel>;
};

