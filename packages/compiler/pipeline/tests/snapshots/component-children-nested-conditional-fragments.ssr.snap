import { Slot } from '@qwik.dev/core';
export const Panel = () => <main><Slot name="header" /><Slot /></main>;
export default (props) => <Panel>{props.show ? <><h1 q:slot="header">Title</h1>{props.details && <><p>Details</p><p>More</p></>}</> : null}</Panel>;

