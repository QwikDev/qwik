import {
  useSignal,
  createSsrNodeId,
  escapeHTML,
  renderSsrTextNode,
  maybeThen,
} from '@qwik.dev/core';
export default (props, ctx) => {
  const count = useSignal(1);
  const id0 = ctx.nextId();
  ctx.addRoot(count);
  const text0 = renderSsrTextNode(id0, 0, count);
  return maybeThen(text0, (text0) => [
    '<div q:id="',
    createSsrNodeId(id0),
    '"><b>a</b><!t>',
    escapeHTML(text0),
    '<!/t></div>',
  ]);
};
