import { component$, useSignal } from '@qwik.dev/core';
export default component$(() => {
  const checked = useSignal(false);
  const text = useSignal('one');
  return (
    <form>
      <input type="checkbox" bind:checked={checked} />
      <textarea bind:value={text} />
    </form>
  );
});

