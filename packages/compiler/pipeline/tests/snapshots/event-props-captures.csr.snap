export const Button = (props) => <button onClick$={props.onSave$}>save</button>;
export default (input) => {
  const suffix = '!';
  return <main>
    <button onClick$={() => input.onSave$(input.id + suffix)}>save</button>
    <Button onSave$={({ value = input.initial } = {}) => input.onSave$(value)} />
  </main>;
};
