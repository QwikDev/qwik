export default (props, ctx) => {
  const icon = useSignal('#a');
  const id0 = ctx.nextId();
  ctx.addRoot(icon);
  const attr0 = renderSsrAttr(id0, 'xlink:href', icon);
  return maybeThen(attr0, (attr0) => [
    '<svg xml:lang="en"><use q:id="',
    createSsrNodeId(id0),
    '"',
    attr0 === null ? '' : ' xlink:href' + (attr0 === '' ? '' : '="' + escapeHTML(attr0) + '"'),
    '></use><use xlink:href="#static"></use></svg>',
