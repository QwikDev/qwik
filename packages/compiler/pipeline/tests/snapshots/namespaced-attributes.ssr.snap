import { component$, useSignal } from '@qwik.dev/core';
export default component$(() => {
  const icon = useSignal('#a');
  return (
    <svg xml:lang="en">
      <use xlink:href={icon.value} />
      <use xlink:href="#static" />
    </svg>
  );
});

