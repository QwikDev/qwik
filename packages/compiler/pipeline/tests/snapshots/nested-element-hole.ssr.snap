import {
  useSignal,
  createSsrNodeId,
  createSsrElementTextTarget,
  escapeHTML,
  renderSsrTextNode,
  maybeThen,
} from '@qwik.dev/core';
export default (props, ctx) => {
  const count = useSignal(0);
  const id0 = ctx.nextId();
  ctx.addRoot(count);
  const text0 = renderSsrTextNode(createSsrElementTextTarget(id0), count);
  return maybeThen(text0, (text0) => [
    '<div><span q:id="',
    createSsrNodeId(id0),
    '">',
    escapeHTML(text0),
    '</span></div>',
  ]);
};
