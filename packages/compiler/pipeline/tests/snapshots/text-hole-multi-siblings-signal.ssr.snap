import {
  useSignal,
  createSsrNodeId,
  createSsrRangeTextTarget,
  escapeHTML,
  renderSsrTextNode,
  maybeThen,
} from '@qwik.dev/core';
export default (props, ctx) => {
  const count = useSignal(0);
  const name = useSignal('Qwik');
  const id0 = ctx.nextId();
  ctx.addRoot(name);
  const text0 = renderSsrTextNode(createSsrRangeTextTarget(id0, 0), name);
  ctx.addRoot(count);
  const text1 = renderSsrTextNode(createSsrRangeTextTarget(id0, 1), count);
  return maybeThen(text0, (text0) =>
    maybeThen(text1, (text1) => [
      '<p q:id="',
      createSsrNodeId(id0),
      '"><!t>',
      escapeHTML(text0),
      '<!/t> count: <!t>',
      escapeHTML(text1),
      '<!/t>!</p>',
    ])
  );
};
