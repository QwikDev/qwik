import { component$, useId } from '@qwik.dev/core';
export default component$((props: { items: string[] }) => {
  const id = useId();
  return (
    <ul id={id}>
      {props.items.map((item) => {
        const rowId = useId();
        return <li id={rowId}>{item}</li>;
      })}
    </ul>
  );
});

