import { useSignal } from '@qwik.dev/core';
export function Child() {
  const hide = useSignal(false);
  return (
    <div>
      {hide.value ? (
        <>
          <label />
          <input />
          <svg />
        </>
      ) : (
        <>
          <label for="value" />
          <input required />
          <svg width="1" />
        </>
      )}
    </div>
  );
}

export function App() {
  return <Child />;
}

