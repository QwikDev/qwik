import { useSignal } from '@qwik.dev/core';
export function App() {
  const items = useSignal([{ id: 'a', label: 'Alpha' }]);
  return (
    <ul>
      {items.value.map((item) => {
        return <li key={item.id}>{item.label}</li>;
      })}
    </ul>
  );
}

