export function Footer(props: { todos: { filter: string } }) {
  function Filter({ filter }: { filter: string }) {
    const lMode = filter.toLowerCase();
    return (
      <li>
        <a class={{ selected: props.todos.filter == lMode }}>{filter}</a>
      </li>
    );
  }
  return (
    <ul>
      <Filter filter="all" />
      <Filter filter="active" />
    </ul>
  );
}

