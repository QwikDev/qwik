export const Panel = component$(() => (
  <div>
    <Slot name="x" />
    <Slot name="y" />
  </div>
));
export function App() {
  const flip = useSignal(false);
  return (
    <Panel>
      {flip.value ? <a q:slot="x">alpha</a> : <b q:slot="y">bravo</b>}
    </Panel>
  );
}

