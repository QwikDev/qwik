import { component$, isBrowser, isDev, isServer, useSignal, useTask$ } from '@qwik.dev/core';
export default component$(() => {
  const count = useSignal(0);
  useTask$(() => {
    if (isServer) {
      count.value = 1;
    }
    if (isBrowser && !isDev) {
      count.value = 2;
    }
  });
  return (
    <button onClick$={() => (count.value = isServer ? 3 : 4)}>
      {isBrowser ? 'client' : 'server'}
    </button>
  );
});
