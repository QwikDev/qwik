import { useSignal } from '@qwik.dev/core';
export default () => {
  const items = useSignal([{ id: 'a', label: 'Alpha' }]);
  const show = useSignal(true);
  return (
    <main>
      {show.value ? (
        <ul>{items.value.map((item) => <li key={item.id}>{item.label}</li>)}</ul>
      ) : null}
    </main>
  );
};

