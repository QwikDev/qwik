import { Slot, useSignal } from '@qwik.dev/core';
export const Panel = () => <main><Slot name="start" /><Slot /></main>;
export default () => {
  const show = useSignal(true);
  return <Panel>{show.value && <span q:slot="start">start</span>}</Panel>;
};

