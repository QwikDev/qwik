import { Slot, useSignal } from '@qwik.dev/core';
export const Panel = () => <main><Slot name="header" /><Slot /></main>;
export default () => {
  const items = useSignal([{ title: 'Title', featured: true, visible: false }]);
  return <Panel>{[{ title: 'Title', featured: true, visible: false }].map(({ title, featured, visible }, index) => featured && index === 0 ? <h2 q:slot="header">{index}:{title}</h2> : visible && <p>{title}</p>)}</Panel>;
};

