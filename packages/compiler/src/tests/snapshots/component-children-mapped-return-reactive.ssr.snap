import { Slot, useSignal } from '@qwik.dev/core';
export const Panel = () => <main><Slot name="header" /></main>;
export default () => {
  const items = useSignal([{ title: 'Title' }]);
  return <Panel>{items.value.map(({ title }) => { /* row */ return (<h2 q:slot="header">{title}</h2>); })}</Panel>;
};

