});
export const Counter = component$(() => {
  const { count, bump } = useCounter(1);
  return <button onClick$={bump}>{count.value}</button>;
});
export const Maybe = component$((props: { flag: boolean }) => {
  useMaybeClick(props.flag, $(() => 1));
  return <div>maybe</div>;
});

