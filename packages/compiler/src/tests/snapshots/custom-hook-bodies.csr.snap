// src/hooks.ts
import { useOn, useSignal, useTask$ } from '@qwik.dev/core';
export const useClick = (handler) => {
  useOn('click', handler);
};
export function useCounter(start) {
  const count = useSignal(start);
  useTask$(() => {
    count.value;
  });
  return { count, bump: () => count.value++ };
}
export function useMaybeClick(flag, handler) {
  if (!flag) {
    return null;
  }
  useOn('click', handler);
  return flag;
}

// src/component.tsx
