import { useSignal } from '@qwik.dev/core';
type Props = { label: string };
export default (props: Props) => {
  const isOpen = useSignal(false);
  return (
    <section>
      <head />
      <p data-qwik-inspector="custom.tsx:1:1">{props.label}</p>
      {isOpen.value && <span>opened</span>}
    </section>
  );
};

