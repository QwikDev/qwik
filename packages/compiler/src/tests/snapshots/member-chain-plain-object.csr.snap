export const Label = (props) => <b>{props.label}</b>;
export default () => {
  const store = useStore({ count: 0 });
  const item = { meta: { label: 'hello' }, format: () => 'x', store };
  return (
    <>
      <Label label={item.meta.label} />
      <span>{item.meta.label}</span>
    </>
  );
};

