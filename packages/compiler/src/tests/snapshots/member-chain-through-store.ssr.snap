import { useStore } from '@qwik.dev/core';
export const Label = (props) => <b>{props.label}</b>;
export default () => {
  const store = useStore({ label: 'a' });
  const item = { meta: store };
  return (
    <>
      <Label label={item.meta.label} />
      <span>{item.meta.label}</span>
    </>
  );
};

