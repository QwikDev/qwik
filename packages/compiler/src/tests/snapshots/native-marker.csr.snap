import { useSignal } from '@qwik.dev/core';
let nextId = 1;
export const buildRows = (count) => {
  const rows = new Array(count);
  for (let i = 0; i < count; i++) {
    rows[i] = {
      id: nextId++,
      label: useSignal('row'),
    };
  }
  return rows;
};
