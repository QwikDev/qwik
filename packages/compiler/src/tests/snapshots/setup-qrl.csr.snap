import { $, useSignal } from '@qwik.dev/core';
export default (props) => {
  const count = useSignal(0);
  const onSave = $((event) => {
    count.value++;
    props.onSave$(props.id, event.type);
  });
  return <main><button onClick$={onSave}>save</button><button onClick$={onSave}>again</button></main>;
};

