import { $, component$ } from '@qwik.dev/core';
import { Fallback, fallback, render } from './x';

export const Cmp = component$(
	({
		Model = Fallback,
		Layout,
		ui = fallback,
		icons,
		'my-icon': Icon,
	}: {
		Model?: any;
		Layout: any;
		ui?: any;
		icons: any;
		'my-icon': any;
	}) => {
		const view = $(() =>
			render(
				<Layout>
					<Model />
					<ui.Home />
					<icons.Star />
					<Icon />
				</Layout>
			)
		);
		return <button onClick$={view} />;
	}
);

