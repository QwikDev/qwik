import { component$, useStore } from '@qwik.dev/core';

export const App = component$(() => {
	const store = useStore({ counter: { count: 1 }, largeData: { data: 'BIG' } });
	const counter = store.counter;
	return <button onClick$={() => counter.count++}>+1</button>;
});

