import { component$, useSignal } from '@qwik.dev/core';

export const List = component$((props: { outputs: any[] }) => {
  const sig = useSignal(false);
  return (
    <div>
      {props.outputs.map((o) => (
        <button
          class={{ [o.name]: sig.value }}
          data-flags={{ [o]: sig.value }}
          aria-busy={(o.a || { [o.name]: sig }).shorten.value}
        />
      ))}
    </div>
  );
});

