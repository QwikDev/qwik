import { $, component$ } from '@qwik.dev/core';
import { render } from './x';

export const Cmp = component$(() => {
	const view = $(() => render(<div />));
	return <button onClick$={view} />;
});

export const Cmp2 = component$(() => {
	const view = $(() => render(<p><span /></p>));
	return <button onClick$={view} />;
});

