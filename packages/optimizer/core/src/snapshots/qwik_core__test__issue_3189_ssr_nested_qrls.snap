import { component$, $ } from '@qwik.dev/core';
import { server$ } from '@qwik.dev/router';

export default component$(() => {
	const name = 'world';
	const capitalize = $((v: string) => v[0].toUpperCase() + v.substring(1));
	return (
		<div>
			<button
				onClick$={async () => {
					server$(async () => {
						console.log(`Hello ${await capitalize(name)}!`);
					})();
				}}
			>
				Click
			</button>
		</div>
	);
});

