import { $ } from '@qwik.dev/core';
import { createCounter } from './counter';

const counter = createCounter();
const config = { size: 1 };
const tracked = createCounter();
const readTracked = () => tracked;

export function make() {
  return [$(() => counter), $(() => config), $(() => readTracked())];
}

