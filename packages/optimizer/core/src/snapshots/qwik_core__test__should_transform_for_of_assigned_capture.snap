import { component$ } from '@qwik.dev/core';
export const List = component$((props) => {
let prefix = 'initial';
const rows = [];
for (const item of props.items) {
  prefix = item.name;
  rows.push(<button onClick$={() => props.select$(prefix, item.name)} />);
}
return <div>{rows}</div>;
});

