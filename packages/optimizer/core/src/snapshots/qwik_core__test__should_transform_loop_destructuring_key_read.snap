import { component$ } from '@qwik.dev/core';
export const List = component$((props) => {
  const key = props.key;
  let prefix = 'initial';
  return <div>{props.items.map(item => {
    ({ [key]: prefix } = item);
    props.log$(prefix);
    return <button onClick$={() => props.select$(key, item.name)} />;
  })}</div>;
});

