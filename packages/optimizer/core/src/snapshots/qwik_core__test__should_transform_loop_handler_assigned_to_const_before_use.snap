import { component$ } from '@qwik.dev/core';

export const List = component$((props) => {
  const rows = props.items.map((item) => (
    <li key={item.id} onClick$={() => props.select$(item.id)} />
  ));
  const title = props.title.toUpperCase();
  return (
    <ul title={title}>
      {rows}
    </ul>
  );
});

