import { component$ } from '@qwik.dev/core';
export const List = component$(async (props) => {
  const { prefix, rows = await Promise.resolve(props.items.map((item) => (
    <button onClick$={() => props.select$(prefix, item)} />
  ))) } = props;
  return <div>{rows}</div>;
});

