import { component$ } from '@qwik.dev/core';
export const List = component$(async (props) => {
  const { rows = props.items.map(item => <button onClick$={() => props.select$(props.prefix, item.name)} />, await props.context) } = props;
  return <div>{rows}</div>;
});

