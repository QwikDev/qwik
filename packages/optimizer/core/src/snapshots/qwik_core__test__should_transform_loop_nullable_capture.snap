import { component$ } from '@qwik.dev/core';
export const List = component$((props) => {
  let prefix = props.prefix;
  if (props.change) prefix = 'changed';
  return <div>{props.items.map(item => <button onClick$={() => props.select$(prefix, 'fixed')} />)}</div>;
});

