import { component$ } from '@qwik.dev/core';
export const List = component$((props) => {
  let rows = [];
  if (props.items.length) {
    var prefix = props.prefix;
    rows = props.items.map(item => <button onClick$={() => props.select$(prefix, item.name)} />);
  }
  return <div>{rows}</div>;
});

