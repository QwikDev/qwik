import { component$ } from '@qwik.dev/core';
export const Facets = component$((props) => {
  const { rows = props.facets.map((facet) => facet.items.map((item) => (
    <input onChange$={() => props.toggle$(facet.slug, item.slug)} />
  ))) } = props;
  return <div>{rows}</div>;
});

