import { component$ } from '@qwik.dev/core';

export const Facets = component$((props) => (
  <div>
    {props.facets.map((facet) => (
      <div key={facet.slug}>
        {facet.items.map((item) => (
          <input key={item.slug} onChange$={() => props.toggle$(facet.slug, item.slug)} />
        ))}
      </div>
    ))}
  </div>
));

