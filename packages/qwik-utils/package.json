    "@qwik.dev/core": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "qwik": "./lib/index.qwik.mjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/QwikDev/qwik.git",
    "directory": "packages/qwik-utils"
  },
  "scripts": {
    "build": "vite build --mode lib",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "typecheck": "tsc --noEmit"
  },
